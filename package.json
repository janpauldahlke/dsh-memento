{
  "name": "dsh-memento",
  "version": "0.1.0",
  "description": "Bounded-file memory for DeepSeek Harness: ME.md + project MEMORY.md vault, cache-stable inject, plain-line inbox. No store, no embeddings, no LLM calls.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs && tsc --noEmit"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "memory",
    "vault"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
