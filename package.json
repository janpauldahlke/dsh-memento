{
  "name": "dsh-local-memento",
  "version": "1.0.1",
  "description": "Bounded-file memory for DeepSeek Harness local agents (ME.md + project MEMORY.md vault, cache-stable inject, inbox, Memory rightbar). No store, no embeddings, no LLM calls.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "media"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janpauldahlke/dsh-memento.git"
  },
  "homepage": "https://github.com/janpauldahlke/dsh-memento#readme",
  "bugs": {
    "url": "https://github.com/janpauldahlke/dsh-memento/issues"
  },
  "scripts": {
    "build": "node build.mjs && tsc --noEmit"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh",
    "cordis",
    "cordis-plugin",
    "memory",
    "vault",
    "agent-memory",
    "inbox",
    "local-agents",
    "coding-agents",
    "sidebar",
    "web-ui"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
